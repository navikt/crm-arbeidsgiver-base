<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Account Summary Banner</masterLabel>
    <description>Bannerversjon av arbeidsgiveroversikten: pågående aktivitet og historikk som tekstlinjer.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>EmployerInquiry__c</object>
            </objects>
            <property
                name="months"
                type="String"
                datasource="6,12"
                default="6"
                label="Historikkperiode (mnd)"
                description="Antall måneder som vises under historikk."
            />
            <property
                name="hideHistory"
                type="Boolean"
                default="false"
                label="Skjul historikk"
                description="Viser bare pågående aktivitet."
            />
            <property
                name="hideWhenEmpty"
                type="Boolean"
                default="false"
                label="Skjul når det ikke er aktivitet"
                description="Skjuler banneret når det verken er pågående aktivitet eller historikk."
            />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
