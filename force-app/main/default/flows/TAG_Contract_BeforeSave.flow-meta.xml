<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Reset_metric_fields</name>
        <label>Reset metric fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfHiredCandidates__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfPresentedCandidates__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfMeetings__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Metric_Values</name>
        <label>Has Metric Values?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Clear_values</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TAG_NumberOfHiredCandidates__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TAG_NumberOfPresentedCandidates__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TAG_NumberOfMeetings__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_metric_fields</targetReference>
            </connector>
            <label>Clear values</label>
        </rules>
    </decisions>
    <description>Clears metric fields on contract record if it is updated and no longer fit criteria for recalculation. Prevents stale data from appearing in reports.</description>
    <environments>Default</environments>
    <formulas>
        <name>hasMetricValues</name>
        <dataType>Boolean</dataType>
        <expression>( {!$Record.TAG_NumberOfMeetings__c} + {!$Record.TAG_NumberOfHiredCandidates__c} + {!$Record.TAG_NumberOfPresentedCandidates__c}  ) &gt; 0</expression>
    </formulas>
    <interviewLabel>TAG Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TAG Contract BeforeSave</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Metric_Values</targetReference>
        </connector>
        <filterFormula>OR(
    AND(
        ISCHANGED({!$Record.TAG_Status__c}),
        ISPICKVAL({!$Record.TAG_Status__c},&apos;Utkast&apos;)
        ),
    AND(
        ISPICKVAL({!$Record.TAG_Status__c},&apos;AVSLUTTET&apos;),
        OR(
            ISBLANK({!$Record.TAG_StartDate__c}),
            ISBLANK({!$Record.TAG_EndDate__c}),
            ISBLANK(TEXT({!$Record.TAG_Category__c}))
        )
    )
)</filterFormula>
        <object>Contract__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
