<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Clear_metric_fields</name>
        <label>Clear metric fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfHiredCandidates__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfPresentedCandidates__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TAG_NumberOfMeetings__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <description>Clears metric fields on contract record if it is updated and no longer fit criteria for recalculation. Prevents stale data from appearing in reports.</description>
    <environments>Default</environments>
    <formulas>
        <name>hasMetricValues</name>
        <dataType>Boolean</dataType>
        <expression>MAX( {!$Record.TAG_NumberOfMeetings__c}, {!$Record.TAG_NumberOfHiredCandidates__c} , {!$Record.TAG_NumberOfPresentedCandidates__c}  ) &gt; 0</expression>
    </formulas>
    <formulas>
        <name>statusChangedToDraft</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISCHANGED({!$Record.TAG_Status__c}),
        ISPICKVAL({!$Record.TAG_Status__c}, &apos;Utkast&apos;) )</expression>
    </formulas>
    <interviewLabel>TAG Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TAG Contract BeforeSave</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Clear_metric_fields</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4 OR 5)</filterLogic>
        <filters>
            <field>TAG_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TAG_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Utkast</stringValue>
            </value>
        </filters>
        <filters>
            <field>TAG_NumberOfHiredCandidates__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TAG_NumberOfMeetings__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TAG_NumberOfPresentedCandidates__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contract__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
