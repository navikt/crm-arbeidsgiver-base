<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Copies owner name to custom indexed field used in reports. Workaround for owner name not being used as index in activity reports.</description>
    <environments>Default</environments>
    <formulas>
        <name>userFullNameFrmla</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.FirstName}&amp;&quot; &quot;&amp;{!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <description>Returns user market region if present or the text &apos;UKJENT&apos;</description>
        <name>userMarketRegionFrmla</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!$Record.Owner:User.CRM_MarketRegion__c}), &quot;UKJENT&quot;,
{!$Record.Owner:User.CRM_MarketRegion__c} )</expression>
    </formulas>
    <formulas>
        <description>Returns user region if present or the text &apos;UKJENT&apos;</description>
        <name>userRegionFrmla</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!$Record.Owner:User.Region__c}), &quot;UKJENT&quot;, {!$Record.Owner:User.Region__c})</expression>
    </formulas>
    <interviewLabel>TAG Update Ansvarlig {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TAG Update Event Ansvarlig</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Nav_unit</name>
        <label>Get Nav unit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_ansvarlig</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>INT_UnitNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Owner:User.Department</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NavUnit__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_ansvarlig</name>
        <label>Update ansvarlig</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Ansvarlig__c</field>
            <value>
                <elementReference>userFullNameFrmla</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TAG_OwnerMarketRegion__c</field>
            <value>
                <elementReference>userMarketRegionFrmla</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TAG_OwnerNavUnit__c</field>
            <value>
                <elementReference>Get_Nav_unit.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TAG_OwnerRegion__c</field>
            <value>
                <elementReference>userRegionFrmla</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Nav_unit</targetReference>
        </connector>
        <filterFormula>AND( 
  OR(
    {!$Record.RecordType.DeveloperName} = &quot;ArbeidsgiverEvent&quot;,
    {!$Record.RecordType.DeveloperName} =&quot;IA_event&quot;,
     {!$Record.RecordType.DeveloperName} =&quot;IPS_UO_Arbeidsgiver&quot;
  ),
  OR(
    ISCHANGED({!$Record.OwnerId}),
    ISNEW(),
    ISBLANK( {!$Record.TAG_OwnerRegion__c})
  )
)</filterFormula>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
