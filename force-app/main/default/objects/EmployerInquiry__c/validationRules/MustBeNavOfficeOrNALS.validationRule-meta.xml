<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MustBeNavOfficeOrNALS</fullName>
    <active>false</active>
    <errorConditionFormula>OR( TAG_NavUnit__r.isActiveUnit__c = false, 
			AND(TAG_NavUnit__r.INT_UnitType__c != &apos;LOKAL&apos;,TAG_NavUnit__r.INT_UnitType__c != &apos;ALS&apos;))</errorConditionFormula>
